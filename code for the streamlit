def synthetic_full_series(
    variable: str,
    place: str,
    lat: float,
    lon: float,
) -> pd.Series:
    """Return deterministic demonstration data. These are not observations."""
    meta = VARIABLES[variable]
    dates = pd.date_range(
        f"{meta['first_year']}-01-01",
        f"{LAST_YEAR}-12-01",
        freq="MS",
    )

    month = dates.month.to_numpy()
    year = dates.year.to_numpy()
    elapsed_years = year - meta["first_year"]

    # Stable, deterministic differences between the target and nearby cells.
    cell_factor = (
        (round(lat * 100) * 31 + round(lon * 100) * 17) % 101 - 50
    ) / 500.0

    seasonal = meta["seasonal_amplitude"] * np.sin(
        (month - 1) * 2 * np.pi / 12 + 0.8
    )
    slow_cycle = meta["cycle_amplitude"] * np.cos(
        elapsed_years / 2.0 + cell_factor
    )
    smooth_variation = meta["noise_amplitude"] * np.sin(
        elapsed_years * 1.7 + month * 0.91 + cell_factor
    )
    long_term_change = meta["trend_per_year"] * elapsed_years
    cell_shift = cell_factor * (
        0.25 if variable == "MERRA2_T2M" else 2.0
    )

    values = (
        meta["base"]
        + seasonal
        + slow_cycle
        + smooth_variation
        + long_term_change
        + cell_shift
    )

    # An invented event to make the demo able to illustrate a one-off.
    # This is not a reconstruction of actual 2022 weather.
    if variable == "GPM_PRECIP":
        values = values - np.where(year == 2022, 20.0, 0.0)
        values = np.clip(values, 5.0, None)
    elif variable == "GLDAS_SSM":
        values = values - np.where(year == 2022, 25.0, 0.0)
        values = np.clip(values, 50.0, None)

    series = pd.Series(values.astype(float), index=dates, name=variable)
    series.index.name = "date"
    return series


def series_for_window(
    full_series: pd.Series,
    start: str,
    end: str,
) -> pd.Series:
    """Keep absent months as NaN rather than silently dropping them."""
    start_month = pd.Timestamp(start).to_period("M").to_timestamp()
    end_month = pd.Timestamp(end).to_period("M").to_timestamp()
    months = pd.date_range(start_month, end_month, freq="MS")
    return full_series.reindex(months)


# ---------------------------------------------------------------------------
# Monthly processing and coverage
# ---------------------------------------------------------------------------

def monthly_climatology(series: pd.Series) -> pd.Series:
    clean = series.dropna().sort_index()
    if clean.empty:
        return pd.Series(dtype=float)
    return clean.groupby(clean.index.month).mean()


def monthly_anomalies(
    series: pd.Series,
    fixed_climatology: pd.Series,
) -> pd.Series:
    ordered = series.sort_index().astype(float)
    if ordered.empty or fixed_climatology.empty:
        return pd.Series(index=ordered.index, dtype=float, name=series.name)

    monthly_means = ordered.index.month.map(fixed_climatology)
    values = ordered.to_numpy() - np.asarray(monthly_means, dtype=float)
    return pd.Series(values, index=ordered.index, name=series.name)


def coverage_details(series: pd.Series) -> dict:
    if series.empty:
        return {
            "months_present": 0.0,
            "full_years": 0,
            "calendar_month_coverage": {month: 0.0 for month in range(1, 13)},
        }

    first_month = series.index.min().to_period("M").to_timestamp()
    last_month = series.index.max().to_period("M").to_timestamp()
    expected = pd.date_range(first_month, last_month, freq="MS")
    present = series.reindex(expected).notna()

    full_years = 0
    for year in range(first_month.year, last_month.year + 1):
        year_months = pd.date_range(f"{year}-01-01", f"{year}-12-01", freq="MS")
        if year_months[0] >= first_month and year_months[-1] <= last_month:
            full_years += 1

    month_coverage = {}
    for month in range(1, 13):
        expected_months = expected[expected.month == month]
        if len(expected_months) == 0:
            month_coverage[month] = 0.0
        else:
            month_coverage[month] = float(
                series.reindex(expected_months).notna().sum() / len(expected_months)
            )

    return {
        "months_present": float(present.sum() / len(expected)) if len(expected) else 0.0,
        "full_years": full_years,
        "calendar_month_coverage": month_coverage,
    }


def coverage_passes(
    details: dict,
    overall_threshold: float = 0.80,
    calendar_month_threshold: float = 0.70,
) -> bool:
    return (
        details["full_years"] >= 10
        and details["months_present"] >= overall_threshold
        and all(
            amount >= calendar_month_threshold
            for amount in details["calendar_month_coverage"].values()
        )
    )


# ---------------------------------------------------------------------------
# Trend calculations
# ---------------------------------------------------------------------------

def seasonal_sen_slope(anomalies: pd.Series) -> float:
    """Median pairwise slope within each calendar month, per decade."""
    clean = anomalies.dropna().sort_index()
    slopes = []

    for month in range(1, 13):
        subset = clean[clean.index.month == month]
        years = subset.index.year.to_numpy(dtype=float)
        values = subset.to_numpy(dtype=float)

        for i in range(len(values) - 1):
            for j in range(i + 1, len(values)):
                if years[j] != years[i]:
                    slopes.append(
                        (values[j] - values[i]) / (years[j] - years[i])
                    )

    return float(np.median(slopes) * 10.0) if slopes else 0.0


def hac_p_value(
    time_years: np.ndarray,
    values: np.ndarray,
    coefficients: np.ndarray,
    residuals: np.ndarray,
    max_lag: int = 12,
) -> float:
    """Newey–West p-value using Bartlett weights and a 12-month lag."""
    n = len(values)
    design = np.column_stack((np.ones(n), time_years))
    lag = min(max_lag, max(n - 1, 0))
    scores = design * residuals[:, None]
    meat = scores.T @ scores

    for offset in range(1, lag + 1):
        weight = 1.0 - offset / (lag + 1.0)
        gamma = scores[offset:].T @ scores[:-offset]
        meat += weight * (gamma + gamma.T)

    bread = np.linalg.pinv(design.T @ design)
    covariance = bread @ meat @ bread
    standard_error = float(np.sqrt(max(covariance[1, 1], 0.0)))

    if not np.isfinite(standard_error) or standard_error == 0:
        return 1.0

    z_score = abs(float(coefficients[1]) / standard_error)
    return float(2.0 * stats.norm.sf(z_score))


def analyze_trend(
    plan: Plan,
    series: pd.Series,
    fixed_climatology: pd.Series,
) -> TrendResult:
    anomalies = monthly_anomalies(series, fixed_climatology).dropna().sort_index()

    if len(anomalies) < 3:
        raise ValueError("At least three observed monthly values are needed.")

    decimal_year = (
        anomalies.index.year.to_numpy(dtype=float)
        + (anomalies.index.month.to_numpy(dtype=float) - 1.0) / 12.0
    )
    elapsed_years = decimal_year - decimal_year.min()
    values = anomalies.to_numpy(dtype=float)

    design = np.column_stack((np.ones(len(values)), elapsed_years))
    coefficients, _, _, _ = np.linalg.lstsq(design, values, rcond=None)
    fitted = design @ coefficients
    residuals = values - fitted

    n = len(values)
    if n > 2:
        r1 = float(np.corrcoef(residuals[:-1], residuals[1:])[0, 1])
    else:
        r1 = 0.0
    if not np.isfinite(r1):
        r1 = 0.0
    r1 = float(np.clip(r1, -0.99, 0.99))

    # Rough AR(1) effective-sample-size adjustment. This is not a full
    # autocorrelation model and should not be read as one.
    n_eff = float(n * (1.0 - r1) / (1.0 + r1))
    n_eff = float(np.clip(n_eff, 1.0, float(n)))

    sxx = float(np.sum((elapsed_years - elapsed_years.mean()) ** 2))
    degrees_freedom = max(n - 2, 1)
    residual_variance = float(np.sum(residuals**2) / degrees_freedom)
    slope_se = float(np.sqrt(residual_variance / sxx)) if sxx else 0.0

    uncertainty_inflation = float(np.sqrt(max(n / n_eff, 1.0)))
    adjusted_slope_se = slope_se * uncertainty_inflation
    adjusted_df = max(n_eff - 2.0, 1.0)

    slope_per_decade = float(coefficients[1] * 10.0)
    if adjusted_slope_se > 0:
        test_statistic = abs(float(coefficients[1]) / adjusted_slope_se)
        p_value = float(2.0 * stats.t.sf(test_statistic, df=adjusted_df))
        critical_value = float(stats.t.ppf(0.975, df=adjusted_df))
    else:
        p_value = 1.0
        critical_value = float(stats.t.ppf(0.975, df=adjusted_df))

    confidence_interval = (
        float((coefficients[1] - critical_value * adjusted_slope_se) * 10.0),
        float((coefficients[1] + critical_value * adjusted_slope_se) * 10.0),
    )

    if p_value < 0.05 and slope_per_decade > 0:
        verdict = "significant increase"
    elif p_value < 0.05 and slope_per_decade < 0:
        verdict = "significant decrease"
    else:
        verdict = "not enough evidence"

    coverage = coverage_details(series)
    hac = hac_p_value(elapsed_years, values, coefficients, residuals)

    # Keep this visibly approximate; it is not a formal power calculation.
    rough_years_needed = (
        float(max(10.0, 1.96**2 / abs(slope_per_decade)))
        if abs(slope_per_decade) > 1e-12
        else float("inf")
    )

    return TrendResult(
        slope_per_decade=slope_per_decade,
        ci=confidence_interval,
        p=p_value,
        verdict=verdict,
        n=n,
        n_eff=n_eff,
        r1=r1,
        coverage=coverage["months_present"],
        years_needed=rough_years_needed,
        sen_per_decade=seasonal_sen_slope(anomalies),
        hac_p=hac,
        settings={
            "variable": plan.variable,
            "method": "OLS on monthly anomalies",
            "climatology": "fixed full-record calendar-month mean",
            "start": plan.start,
            "end": plan.end,
            "hac_lag_months": 12,
        },
        warnings=[
            "The AR(1) effective-sample-size adjustment is rough, not a full solution to autocorrelation.",
            "The years-needed figure is a rough estimate; it assumes the current rate and AR(1) noise.",
            "The HAC/Newey–West cross-check uses a fixed 12-month Bartlett lag.",
            "All current values are synthetic demo data, not NASA observations.",
        ],
    )


