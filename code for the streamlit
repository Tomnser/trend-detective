    anomalies = monthly_anomalies(
        selected_series,
        fixed_climatology,
    ).dropna()

    if not anomalies.empty:
        decimal_year = (
            anomalies.index.year.to_numpy(dtype=float)
            + (anomalies.index.month.to_numpy(dtype=float) - 1.0) / 12.0
        )
        elapsed_years = decimal_year - decimal_year.min()
        design = np.column_stack((np.ones(len(elapsed_years)), elapsed_years))
        values = anomalies.to_numpy(dtype=float)
        coefficients, _, _, _ = np.linalg.lstsq(design, values, rcond=None)
        fitted = design @ coefficients
        residuals = values - fitted

        sxx = float(np.sum((elapsed_years - elapsed_years.mean()) ** 2))
        residual_variance = float(
            np.sum(residuals**2) / max(len(values) - 2, 1)
        )
        sigma = np.sqrt(max(residual_variance, 0.0))
        n_eff = max(result.n_eff, 1.0)
        approximate_band_scale = np.sqrt(max(len(values) / n_eff, 1.0))
        df = max(n_eff - 2.0, 1.0)
        t_critical = float(stats.t.ppf(0.975, df=df))
        leverage = (
            1.0 / len(values)
            + (elapsed_years - elapsed_years.mean()) ** 2 / sxx
            if sxx > 0
            else np.zeros(len(values))
        )
        half_width = t_critical * sigma * approximate_band_scale * np.sqrt(leverage)

        figure = make_subplots(
            rows=2,
            cols=1,
            shared_xaxes=True,
            vertical_spacing=0.10,
            subplot_titles=("Raw monthly values (faint)", "Monthly anomalies and fitted trend"),
        )
        figure.add_trace(
            go.Scatter(
                x=selected_series.index,
                y=selected_series.values,
                mode="lines",
                name="Raw monthly value",
                line={"color": "#9aa4ad", "width": 1},
                opacity=0.55,
            ),
            row=1,
            col=1,
        )
        figure.add_trace(
            go.Scatter(
                x=anomalies.index,
                y=fitted + half_width,
                mode="lines",
                line={"width": 0},
                showlegend=False,
                hoverinfo="skip",
            ),
            row=2,
            col=1,
        )
        figure.add_trace(
            go.Scatter(
                x=anomalies.index,
                y=fitted - half_width,
                mode="lines",
                name="Approx. 95% trend band",
                fill="tonexty",
                fillcolor="rgba(41,128,185,0.16)",
                line={"width": 0},
                hoverinfo="skip",
            ),
            row=2,
            col=1,
        )
        figure.add_trace(
            go.Scatter(
                x=anomalies.index,
                y=anomalies.values,
                mode="lines",
                name="Monthly anomaly",
                line={"color": "#d35400", "width": 1.5},
            ),
            row=2,
            col=1,
        )
        figure.add_trace(
            go.Scatter(
                x=anomalies.index,
                y=fitted,
                mode="lines",
                name="OLS trend",
                line={"color": "#1f77b4", "width": 3},
            ),
            row=2,
            col=1,
        )
        figure.update_yaxes(title_text=meta["unit"], row=1, col=1)
        figure.update_yaxes(title_text=f"Anomaly ({meta['unit']})", row=2, col=1)
        figure.update_xaxes(title_text="Month", row=2, col=1)
        figure.update_layout(
            height=650,
            title="Monthly series and anomalies",
            legend_title="Series",
        )
        st.plotly_chart(figure, use_container_width=True)
        st.caption(
            "The plotted band is an approximate trend uncertainty band using "
            "the same rough AR(1) adjustment; it is not a full autocorrelation model."
        )

    st.subheader("Challenge my finding")
    st.caption(
        "These checks are a fixed set. The baseline stays visible above; "
        "the app does not search arbitrary settings for a preferred result."
    )

    challenge_rows = build_challenges(
        plan,
        result,
        full_series,
        fixed_climatology,
    )

    for row in challenge_rows:
        with st.container(border=True):
            st.markdown(f"**{row.label}**")
            st.write(row.note)

            if row.display_method == "HAC":
                slope_text = f"{row.result.slope_per_decade:.3f}/decade"
                p_text = f"{row.result.hac_p:.3g} (HAC)"
            elif row.display_method == "Sen":
                slope_text = f"{row.result.sen_per_decade:.3f}/decade (Sen)"
                p_text = "cross-check only"
            else:
                slope_text = f"{row.result.slope_per_decade:.3f}/decade"
                p_text = f"{row.result.p:.3g}"

            st.write(
                f"Slope: {slope_text} · p-value: {p_text} · "
                f"coverage: {row.result.coverage:.1%} · "
                f"{row.result.verdict}"
            )

            if row.category == "coverage":
                st.write(
                    "Passes this threshold: "
                    + ("yes" if row.coverage_passes else "no")
                )
            elif row.category == "date" and row.coverage_passes is False:
                st.write("Coverage rule passes: no")
