def build_challenges(
    plan: Plan,
    baseline: TrendResult,
    baseline_full_series: pd.Series,
    baseline_climatology: pd.Series,
) -> list[ChallengeRow]:
    rows: list[ChallengeRow] = []
    variable_start = VARIABLES[plan.variable]["first_year"]

    # Fixed date-window set. All use the same baseline full-record climatology.
    for year in (1981, 1990, 2000, 2010):
        year = max(year, variable_start)
        start = f"{year}-01-01"
        if pd.Timestamp(start) >= pd.Timestamp(plan.end):
            continue

        variant_series = series_for_window(baseline_full_series, start, plan.end)
        variant_plan = Plan(
            place=plan.place,
            lat=plan.lat,
            lon=plan.lon,
            variable=plan.variable,
            start=start,
            end=plan.end,
        )
        details = coverage_details(variant_series)

        try:
            result = analyze_trend(
                variant_plan,
                variant_series,
                baseline_climatology,
            )
            note = (
                "Changes the fitted date window; it reuses the same "
                "full-record monthly climatology as the baseline."
            )
        except ValueError:
            result = baseline
            note = "Not enough data in this date window to calculate a trend."

        rows.append(
            ChallengeRow(
                "date",
                f"Date: {start} to {plan.end}",
                result,
                note,
                coverage_passes=coverage_passes(details),
            )
        )

    # Target cell and four predefined neighbours.
    for dlat, dlon, direction in (
        (-0.25, 0.00, "north neighbour"),
        (0.25, 0.00, "south neighbour"),
        (0.00, 0.25, "east neighbour"),
        (0.00, -0.25, "west neighbour"),
    ):
        lat, lon = plan.lat + dlat, plan.lon + dlon
        full = synthetic_full_series(plan.variable, plan.place, lat, lon)
        window = series_for_window(full, plan.start, plan.end)
        fixed_climatology = monthly_climatology(full)
        variant = Plan(
            place=plan.place,
            lat=lat,
            lon=lon,
            variable=plan.variable,
            start=plan.start,
            end=plan.end,
        )

        try:
            result = analyze_trend(variant, window, fixed_climatology)
            note = (
                "Changes the target coordinates to a predefined nearby demo cell. "
                "These are not real NASA grid-cell values."
            )
        except ValueError:
            result = baseline
            note = "Not enough data in this cell to calculate a trend."

        rows.append(
            ChallengeRow(
                "region",
                f"Region: {direction} ({lat:.2f}, {lon:.2f})",
                result,
                note,
            )
        )

    rows.extend(
        [
            ChallengeRow(
                "method",
                "Method: OLS (baseline)",
                baseline,
                "Primary method. Its uncertainty uses the stated rough AR(1) adjustment.",
                display_method="OLS",
            ),
            ChallengeRow(
                "method",
                "Method: HAC/Newey–West",
                baseline,
                "Keeps the OLS slope and compares the p-value using a fixed 12-month HAC lag.",
                display_method="HAC",
            ),
            ChallengeRow(
                "method",
                "Method: seasonal Sen’s slope",
                baseline,
                "Shows a robust within-calendar-month slope cross-check; it does not replace the verdict.",
                display_method="Sen",
            ),
        ]
    )

    # Coverage challenges do not refit the trend; they apply fixed thresholds
    # to the same observations and report whether those rules pass.
    details = coverage_details(series_for_window(baseline_full_series, plan.start, plan.end))
    for label, overall, monthly, note in (
        (
            "default threshold",
            0.80,
            0.70,
            "Requires at least 10 full calendar years, 80% overall month coverage, "
            "and 70% coverage for each calendar month.",
        ),
        (
            "stricter threshold",
            0.90,
            0.75,
            "Requires at least 10 full calendar years, 90% overall month coverage, "
            "and 75% coverage for each calendar month.",
        ),
    ):
        passes = (
            details["full_years"] >= 10
            and details["months_present"] >= overall
            and all(value >= monthly for value in details["calendar_month_coverage"].values())
        )
        rows.append(
            ChallengeRow(
                "coverage",
                f"Coverage: {label}",
                baseline,
                note,
                coverage_passes=passes,
            )
        )

    return rows


