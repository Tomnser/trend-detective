from __future__ import annotations

from dataclasses import asdict, dataclass, field
import json
from datetime import date

import numpy as np
import pandas as pd
import plotly.graph_objects as go
import streamlit as st
from plotly.subplots import make_subplots
from scipy import stats


# ---------------------------------------------------------------------------
# Data contracts
# ---------------------------------------------------------------------------

@dataclass
class Plan:
    place: str
    lat: float
    lon: float
    variable: str
    start: str
    end: str


@dataclass
class TrendResult:
    slope_per_decade: float
    ci: tuple[float, float]
    p: float
    verdict: str
    n: int
    n_eff: float
    r1: float
    coverage: float
    sen_per_decade: float
    hac_p: float
    settings: dict = field(default_factory=dict)
    warnings: list[str] = field(default_factory=list)


@dataclass
class ChallengeRow:
    category: str
    label: str
    result: TrendResult | None
    note: str
    display_method: str = "OLS"
    coverage_passes: bool | None = None


# ---------------------------------------------------------------------------
# Catalogue and deterministic synthetic demo data
# ---------------------------------------------------------------------------

VARIABLES = {
    "MERRA2_T2M": {
        "label": "Synthetic temperature at 2 m",
        "theme": "temperature",
        "unit": "°C",
        "first_year": 1981,
        "base": 15.0,
        "seasonal_amplitude": 8.0,
        "trend_per_year": 0.035,
        "cycle_amplitude": 0.8,
        "noise_amplitude": 0.20,
    },
    "GPM_PRECIP": {
        "label": "Synthetic precipitation",
        "theme": "precipitation",
        "unit": "mm/month",
        "first_year": 2001,
        "base": 65.0,
        "seasonal_amplitude": 28.0,
        "trend_per_year": -0.15,
        "cycle_amplitude": 14.0,
        "noise_amplitude": 3.5,
    },
    "GLDAS_SSM": {
        "label": "Synthetic soil moisture",
        "theme": "soil moisture",
        "unit": "kg/m²",
        "first_year": 2001,
        "base": 180.0,
        "seasonal_amplitude": 30.0,
        "trend_per_year": -0.08,
        "cycle_amplitude": 9.0,
        "noise_amplitude": 4.0,
    },
}

PLACES = {
    "Milan": (45.4642, 9.1900),
    "Po Valley": (45.0000, 10.0000),
    "Bergamo": (45.6983, 9.6773),
}

LAST_YEAR = 2025


def synthetic_full_series(
    variable: str,
    place: str,
    lat: float,
    lon: float,
) -> pd.Series:
    """Return deterministic demonstration data. These are not observations."""
    meta = VARIABLES[variable]
    dates = pd.date_range(
        f"{meta['first_year']}-01-01",
        f"{LAST_YEAR}-12-01",
        freq="MS",
    )

    month = dates.month.to_numpy()
    year = dates.year.to_numpy()
    elapsed_years = year - meta["first_year"]

    # Stable, deterministic differences between the target and nearby cells.
    cell_factor = (
        (round(lat * 100) * 31 + round(lon * 100) * 17) % 101 - 50
    ) / 500.0

    seasonal = meta["seasonal_amplitude"] * np.sin(
        (month - 1) * 2 * np.pi / 12 + 0.8
    )
    slow_cycle = meta["cycle_amplitude"] * np.cos(
        elapsed_years / 2.0 + cell_factor
    )
    smooth_variation = meta["noise_amplitude"] * np.sin(
        elapsed_years * 1.7 + month * 0.91 + cell_factor
    )
    long_term_change = meta["trend_per_year"] * elapsed_years
    cell_shift = cell_factor * (
        0.25 if variable == "MERRA2_T2M" else 2.0
    )

    values = (
        meta["base"]
        + seasonal
        + slow_cycle
        + smooth_variation
        + long_term_change
        + cell_shift
    )

    # An invented event to make the demo able to illustrate a one-off.
    # This is not a reconstruction of actual 2022 weather.
    if variable == "GPM_PRECIP":
        values = values - np.where(year == 2022, 20.0, 0.0)
        values = np.clip(values, 5.0, None)
    elif variable == "GLDAS_SSM":
        values = values - np.where(year == 2022, 25.0, 0.0)
        values = np.clip(values, 50.0, None)

    series = pd.Series(values.astype(float), index=dates, name=variable)
    series.index.name = "date"
    return series


def series_for_window(
    full_series: pd.Series,
    start: str,
    end: str,
) -> pd.Series:
    """Keep absent months as NaN rather than silently dropping them."""
    if pd.Timestamp(start) > pd.Timestamp(end):
        raise ValueError("Start must precede end.")
    start_month = pd.Timestamp(start).to_period("M").to_timestamp()
    end_month = pd.Timestamp(end).to_period("M").to_timestamp()
    months = pd.date_range(start_month, end_month, freq="MS")
    return full_series.reindex(months)


# ---------------------------------------------------------------------------
# Monthly processing and coverage
# ---------------------------------------------------------------------------

def monthly_climatology(series: pd.Series) -> pd.Series:
    clean = series.dropna().sort_index()
    if clean.empty:
        return pd.Series(dtype=float)
    return clean.groupby(clean.index.month).mean()


def monthly_anomalies(
    series: pd.Series,
    fixed_climatology: pd.Series,
) -> pd.Series:
    ordered = series.sort_index().astype(float)
    if ordered.empty or fixed_climatology.empty:
        return pd.Series(index=ordered.index, dtype=float, name=series.name)

    monthly_means = ordered.index.month.map(fixed_climatology)
    values = ordered.to_numpy() - np.asarray(monthly_means, dtype=float)
    return pd.Series(values, index=ordered.index, name=series.name)


def coverage_details(series: pd.Series) -> dict:
    if series.empty:
        return {
            "months_present": 0.0,
            "full_years": 0,
            "calendar_month_coverage": {month: 0.0 for month in range(1, 13)},
        }

    first_month = series.index.min().to_period("M").to_timestamp()
    last_month = series.index.max().to_period("M").to_timestamp()
    expected = pd.date_range(first_month, last_month, freq="MS")
    present = series.reindex(expected).notna()

    full_years = 0
    for year in range(first_month.year, last_month.year + 1):
        year_months = pd.date_range(f"{year}-01-01", f"{year}-12-01", freq="MS")
        if series.reindex(year_months).notna().all():
            full_years += 1

    month_coverage = {}
    for month in range(1, 13):
        expected_months = expected[expected.month == month]
        if len(expected_months) == 0:
            month_coverage[month] = 0.0
        else:
            month_coverage[month] = float(
                series.reindex(expected_months).notna().sum() / len(expected_months)
            )

    return {
        "months_present": float(present.sum() / len(expected)) if len(expected) else 0.0,
        "full_years": full_years,
        "calendar_month_coverage": month_coverage,
    }


def coverage_passes(
    details: dict,
    overall_threshold: float = 0.80,
    calendar_month_threshold: float = 0.70,
) -> bool:
    return (
        details["full_years"] >= 10
        and details["months_present"] >= overall_threshold
        and all(
            amount >= calendar_month_threshold
            for amount in details["calendar_month_coverage"].values()
        )
    )


# ---------------------------------------------------------------------------
# Trend calculations
# ---------------------------------------------------------------------------

def seasonal_sen_slope(anomalies: pd.Series) -> float:
    """Median pairwise slope within each calendar month, per decade."""
    clean = anomalies.dropna().sort_index()
    slopes = []

    for month in range(1, 13):
        subset = clean[clean.index.month == month]
        years = subset.index.year.to_numpy(dtype=float)
        values = subset.to_numpy(dtype=float)

        for i in range(len(values) - 1):
            for j in range(i + 1, len(values)):
                if years[j] != years[i]:
                    slopes.append(
                        (values[j] - values[i]) / (years[j] - years[i])
                    )

    return float(np.median(slopes) * 10.0) if slopes else float("nan")


def analyze_trend(plan: Plan, series: pd.Series,
                  fixed_climatology: pd.Series) -> TrendResult:
    """Exploratory OLS with one consistent Bartlett HAC uncertainty estimate.

    Require a complete monthly sequence: observation lags then equal month lags.
    This demonstration method still requires scientific validation for real data.
    """
    expected = series_for_window(series, plan.start, plan.end)
    if expected.empty or not np.isfinite(expected.to_numpy(dtype=float)).all():
        raise ValueError("Trend inference requires a complete, finite monthly series. Missing months are not filled.")
    if not coverage_passes(coverage_details(expected)):
        raise ValueError("Trend inference requires at least ten complete years and adequate coverage.")
    anomalies = monthly_anomalies(expected, fixed_climatology)
    if not np.isfinite(anomalies.to_numpy()).all():
        raise ValueError("The fixed reference is missing calendar-month means.")
    t = np.arange(len(anomalies), dtype=float) / 12.0
    design = np.column_stack((np.ones(len(t)), t))
    coefficients = np.linalg.lstsq(design, anomalies.to_numpy(), rcond=None)[0]
    residuals = anomalies.to_numpy() - design @ coefficients
    n = len(t)
    lag = min(12, n - 1)
    scores = design * residuals[:, None]
    meat = scores.T @ scores
    for offset in range(1, lag + 1):
        gamma = scores[offset:].T @ scores[:-offset]
        meat += (1.0 - offset / (lag + 1)) * (gamma + gamma.T)
    bread = np.linalg.pinv(design.T @ design)
    covariance = bread @ meat @ bread * n / (n - 2)
    se = float(np.sqrt(max(covariance[1, 1], 0.0)))
    slope = float(coefficients[1])
    if se <= 1e-14:
        raise ValueError("Residual variation is too small for meaningful uncertainty estimation.")
    p = float(2 * stats.norm.sf(abs(slope / se)))
    critical = float(stats.norm.ppf(0.975))
    ci = ((slope - critical * se) * 10, (slope + critical * se) * 10)
    verdict = ("significant increase" if slope > 0 else "significant decrease") if p < .05 else "not enough evidence"
    r1 = float(np.corrcoef(residuals[:-1], residuals[1:])[0, 1])
    return TrendResult(
        slope_per_decade=slope * 10, ci=ci, p=p, verdict=verdict,
        n=n, n_eff=float(n), r1=r1, coverage=1.0,
        sen_per_decade=seasonal_sen_slope(anomalies), hac_p=p,
        settings={"method": "OLS on fixed-reference monthly anomalies; Bartlett HAC",
                  "hac_lag_months": lag, "small_sample_factor": "n/(n-2)",
                  "reference": "full synthetic record calendar-month means",
                  "reference_start": str(VARIABLES[plan.variable]["first_year"]),
                  "reference_end": str(LAST_YEAR),
                  "missing_data_policy": "reject gaps for inference; no filling",
                  "interval": "95% asymptotic normal", "alpha": .05,
                  "variable": plan.variable, "start": plan.start, "end": plan.end},
        warnings=["Exploratory demonstration: fixed 12-month HAC settings need validation before real-data use.",
                  "Sensitivity checks do not correct for selecting an interesting result.",
                  "All values are synthetic; conclusions do not describe real locations."])


# ---------------------------------------------------------------------------
# Fixed challenge panel
# ---------------------------------------------------------------------------

def build_challenges(
    plan: Plan,
    baseline: TrendResult,
    baseline_full_series: pd.Series,
    baseline_climatology: pd.Series,
) -> list[ChallengeRow]:
    rows: list[ChallengeRow] = []
    variable_start = VARIABLES[plan.variable]["first_year"]

    # Fixed date-window set. All use the same baseline full-record climatology.
    for year in sorted({max(year, variable_start) for year in (1981, 1990, 2000, 2010)}):
        start = f"{year}-01-01"
        if pd.Timestamp(start) >= pd.Timestamp(plan.end):
            continue

        variant_series = series_for_window(baseline_full_series, start, plan.end)
        variant_plan = Plan(
            place=plan.place,
            lat=plan.lat,
            lon=plan.lon,
            variable=plan.variable,
            start=start,
            end=plan.end,
        )
        details = coverage_details(variant_series)

        try:
            result = analyze_trend(
                variant_plan,
                variant_series,
                baseline_climatology,
            )
            note = (
                "Changes the fitted date window; it reuses the same "
                "full-record monthly climatology as the baseline."
            )
        except ValueError:
            result = None
            note = "Not enough data in this date window to calculate a trend."

        rows.append(
            ChallengeRow(
                "date",
                f"Date: {start} to {plan.end}",
                result,
                note,
                coverage_passes=coverage_passes(details),
            )
        )

    # Target cell and four predefined neighbours.
    for dlat, dlon, direction in (
        (0.25, 0.00, "north demo offset"),
        (-0.25, 0.00, "south demo offset"),
        (0.00, 0.25, "east demo offset"),
        (0.00, -0.25, "west demo offset"),
    ):
        lat, lon = plan.lat + dlat, plan.lon + dlon
        full = synthetic_full_series(plan.variable, plan.place, lat, lon)
        window = series_for_window(full, plan.start, plan.end)
        fixed_climatology = monthly_climatology(full)
        variant = Plan(
            place=plan.place,
            lat=lat,
            lon=lon,
            variable=plan.variable,
            start=plan.start,
            end=plan.end,
        )

        try:
            result = analyze_trend(variant, window, fixed_climatology)
            note = (
                "Changes the target coordinates to a predefined nearby demo cell. "
                "These are not real NASA grid-cell values."
            )
        except ValueError:
            result = None
            note = "Not enough data in this cell to calculate a trend."

        rows.append(
            ChallengeRow(
                "region",
                f"Region: {direction} ({lat:.2f}, {lon:.2f})",
                result,
                note,
            )
        )

    rows.extend(
        [
            ChallengeRow(
                "method",
                "Method: OLS (baseline)",
                baseline,
                "Primary exploratory method: OLS with 12-month Bartlett HAC uncertainty.",
                display_method="OLS",
            ),
            ChallengeRow(
                "method",
                "Method: seasonal Sen’s slope",
                baseline,
                "Shows a robust within-calendar-month slope cross-check; it does not replace the verdict.",
                display_method="Sen",
            ),
        ]
    )

    # Coverage challenges do not refit the trend; they apply fixed thresholds
    # to the same observations and report whether those rules pass.
    details = coverage_details(series_for_window(baseline_full_series, plan.start, plan.end))
    for label, overall, monthly, note in (
        (
            "default threshold",
            0.80,
            0.70,
            "Requires at least 10 full calendar years, 80% overall month coverage, "
            "and 70% coverage for each calendar month.",
        ),
        (
            "stricter threshold",
            0.90,
            0.75,
            "Requires at least 10 full calendar years, 90% overall month coverage, "
            "and 75% coverage for each calendar month.",
        ),
    ):
        passes = (
            details["full_years"] >= 10
            and details["months_present"] >= overall
            and all(value >= monthly for value in details["calendar_month_coverage"].values())
        )
        rows.append(
            ChallengeRow(
                "coverage",
                f"Coverage: {label}",
                baseline,
                note,
                coverage_passes=passes,
            )
        )

    return rows


def main() -> None:
    st.set_page_config(page_title="Trend Detective", page_icon="🌦️", layout="wide")
    st.title("Trend Detective")
    st.warning("Synthetic demonstration only. No NASA observations or data retrieval are connected.")
    st.caption("Explore monthly patterns and how analytical choices affect a finding.")

    # Dependent controls rerun immediately; applied results have their own state.
    place = st.selectbox("Location", list(PLACES))
    variable = st.selectbox("Variable", list(VARIABLES),
                            format_func=lambda key: VARIABLES[key]["label"])
    earliest = date(VARIABLES[variable]["first_year"], 1, 1)
    latest = date(LAST_YEAR, 12, 1)
    for key, default in (("start", earliest), ("end", latest)):
        st.session_state[key] = min(latest, max(earliest, st.session_state.get(key, default)))
    with st.form("investigation"):
        left, right = st.columns(2)
        start = left.date_input("Start month", min_value=earliest, max_value=latest, key="start")
        end = right.date_input("End month", min_value=earliest, max_value=latest, key="end")
        st.caption("Dates are interpreted as whole months. At least ten complete years are required.")
        submitted = st.form_submit_button("Check the finding", type="primary")
    if submitted:
        lat, lon = PLACES[place]
        candidate = Plan(place, lat, lon, variable,
                         pd.Timestamp(start).to_period("M").start_time.date().isoformat(),
                         pd.Timestamp(end).to_period("M").start_time.date().isoformat())
        try:
            full = synthetic_full_series(variable, place, lat, lon)
            window = series_for_window(full, candidate.start, candidate.end)
            reference = monthly_climatology(full)
            result = analyze_trend(candidate, window, reference)
            challenges = build_challenges(candidate, result, full, reference)
        except ValueError as error:
            st.error(str(error))
        else:
            st.session_state["applied"] = (candidate, window, reference, result, challenges)

    if "applied" not in st.session_state:
        st.info("Choose a variable and dates, then check the finding.")
        return
    plan, window, reference, result, challenges = st.session_state["applied"]
    meta = VARIABLES[plan.variable]
    st.subheader("Applied investigation")
    st.write(f"{plan.place} · {meta['label']} · {plan.start[:7]} to {plan.end[:7]}")
    if (place, variable, str(start)[:7], str(end)[:7]) != (plan.place, plan.variable, plan.start[:7], plan.end[:7]):
        st.info("Controls have changed. The results below still describe the applied investigation; submit to update them.")
    columns = st.columns(4)
    columns[0].metric("Change per decade", f"{result.slope_per_decade:.3f} {meta['unit']}")
    columns[1].metric("95% interval", f"{result.ci[0]:.3f} to {result.ci[1]:.3f}")
    columns[2].metric("HAC p-value", f"{result.p:.3g}")
    columns[3].metric("Monthly coverage", f"{result.coverage:.1%}")
    st.write(f"Exploratory demo verdict: **{result.verdict}**.")
    for warning in result.warnings:
        st.caption(warning)

    anomalies = monthly_anomalies(window, reference)
    figure = make_subplots(rows=2, cols=1, shared_xaxes=True,
                           subplot_titles=("Synthetic monthly values", "Fixed-reference monthly anomalies"))
    figure.add_trace(go.Scatter(x=window.index, y=window.values, name=meta["label"], connectgaps=False), row=1, col=1)
    figure.add_trace(go.Scatter(x=anomalies.index, y=anomalies.values, name="Anomalies", connectgaps=False), row=2, col=1)
    t = np.arange(len(anomalies)) / 12
    fitted = anomalies.mean() + result.slope_per_decade / 10 * (t - t.mean())
    figure.add_trace(go.Scatter(x=anomalies.index, y=fitted, name="Fitted trend"), row=2, col=1)
    figure.update_yaxes(title_text=meta["unit"], row=1, col=1)
    figure.update_yaxes(title_text=f"Anomaly ({meta['unit']})", row=2, col=1)
    figure.update_layout(height=620)
    st.plotly_chart(figure, use_container_width=True)

    st.subheader("Challenge my finding")
    st.caption("Predefined exploratory checks; offsets are synthetic locations, not verified NASA grid cells. Sen’s slope is descriptive only.")
    rows = []
    for check in challenges:
        value = check.result
        sen = check.display_method == "Sen"
        rows.append({"Check": check.label,
                     "Status": "Unavailable" if value is None else "Calculated",
                     f"Change ({meta['unit']}/decade)": None if value is None else value.sen_per_decade if sen else value.slope_per_decade,
                     "95% lower": None if value is None or sen else value.ci[0],
                     "95% upper": None if value is None or sen else value.ci[1],
                     "p-value": None if value is None or sen else value.p,
                     "Interpretation": "Unavailable" if value is None else "Descriptive slope only" if sen else value.verdict,
                     "Coverage rule passes": check.coverage_passes, "Explanation": check.note})
    st.dataframe(pd.DataFrame(rows), hide_index=True, use_container_width=True)
    observations = pd.DataFrame({"date": window.index, "value": window.values,
                                 "anomaly": anomalies.values, "unit": meta["unit"],
                                 "is_synthetic": True})
    with st.expander("View original values"):
        st.dataframe(observations, hide_index=True)
    evidence = {"is_synthetic": True, "source": "deterministic synthetic generator",
                "plan": asdict(plan), "units": meta["unit"],
                "coverage": coverage_details(window), "analysis": asdict(result),
                "challenges": rows}
    st.download_button("Download synthetic observations (CSV)",
                       observations.to_csv(index=False).encode(), "synthetic_observations.csv", "text/csv")
    st.download_button("Download evidence record (JSON)",
                       json.dumps(evidence, ensure_ascii=False, indent=2, allow_nan=False).encode(),
                       "synthetic_evidence.json", "application/json")


if __name__ == "__main__":
    main()
